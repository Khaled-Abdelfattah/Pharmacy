@model List<PharmacySystem.Models.ViewModels.OrderListItemVM>
@{
    ViewData["Title"] = "Orders";
    var reorderNeeds = ViewBag.ReorderNeeds as List<PharmacySystem.Models.ViewModels.ReorderNeedVM> ?? new();
    // Group by category
    var availNeeds = reorderNeeds.Where(r => r.CategoryId == 1).ToList();
    var defNeeds   = reorderNeeds.Where(r => r.CategoryId == 2).ToList();
    var careNeeds  = reorderNeeds.Where(r => r.CategoryId == 3).ToList();
}

<div class="page-header">
    <div>
        <h2 class="page-title">Orders</h2>
        <p class="page-subtitle">Manage procurement orders from suppliers</p>
    </div>
    <a href="/Orders/Create" class="btn btn-success" id="btn-new-order">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        New Order
    </a>
</div>

<div class="page-body">

    <!-- ── Needs Reorder ──────────────────────────────────────── -->
    @if (reorderNeeds.Count > 0)
    {
        <div class="reorder-panel">
            <div class="reorder-panel-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                Needs Reorder — @reorderNeeds.Count product(s) are out of stock
            </div>

            @if (availNeeds.Any())
            {
                <div style="font-size:12px;font-weight:700;color:#92400E;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;">Available Medicines</div>
                @foreach (var r in availNeeds)
                {
                    <div class="reorder-item-row">
                        <span>@r.ProductName</span>
                        <span style="font-size:11px;color:#92400E;">Since @r.AddedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                    </div>
                }
            }
            @if (defNeeds.Any())
            {
                <div style="font-size:12px;font-weight:700;color:#92400E;margin:10px 0 6px;text-transform:uppercase;letter-spacing:0.5px;">Deficient Medicines</div>
                @foreach (var r in defNeeds)
                {
                    <div class="reorder-item-row">
                        <span>@r.ProductName</span>
                        <span style="font-size:11px;color:#92400E;">Since @r.AddedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                    </div>
                }
            }
            @if (careNeeds.Any())
            {
                <div style="font-size:12px;font-weight:700;color:#92400E;margin:10px 0 6px;text-transform:uppercase;letter-spacing:0.5px;">Personal Care Products</div>
                @foreach (var r in careNeeds)
                {
                    <div class="reorder-item-row">
                        <span>@r.ProductName</span>
                        <span style="font-size:11px;color:#92400E;">Since @r.AddedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                    </div>
                }
            }

            <div style="margin-top:12px;">
                <a href="/Orders/Create" class="btn btn-outline btn-sm" id="btn-order-restock">
                    + Create Order for these items
                </a>
            </div>
        </div>
    }

    <!-- ── Orders List ────────────────────────────────────────── -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">All Orders (@Model.Count)</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state" style="padding:50px 20px;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                <h3>No orders yet</h3>
                <p><a href="/Orders/Create">Create your first order</a></p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Supplier</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr id="order-row-@o.Id">
                                <td><span class="badge badge-primary">#@o.Id</span></td>
                                <td><strong>@o.SupplierName</strong></td>
                                <td>@o.OrderDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>@o.ItemCount product(s)</td>
                                <td>
                                    @if (o.Status == "Received")
                                    {
                                        <span class="badge badge-success">✓ Received</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">⏳ Pending</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Orders/Detail/@o.Id" class="btn btn-outline btn-sm" id="btn-detail-@o.Id">View Detail</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
